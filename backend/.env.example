PORT=5000
NODE_ENV=development

# Database connection URL
# Replace with your actual local PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/heartsync?schema=public"

# Authentication Secrets
JWT_SECRET="heartsync_jwt_access_secret_change_me_in_production_12345"
JWT_REFRESH_SECRET="heartsync_jwt_refresh_secret_change_me_in_production_12345"

# Image Storage Config
# Options: local, s3
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Redis Config (Only needed if using BullMQ. If empty or missing, in-memory queue will run)
REDIS_URL="redis://localhost:6379"

# S3 Configuration (Only needed if STORAGE_TYPE=s3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=

# Email service API key (e.g. Resend)
RESEND_API_KEY=
EMAIL_FROM="noreply@heartsync.app"
